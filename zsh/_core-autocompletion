#compdef core

function _core {
    local line

    _arguments -C \
        "-h[use 'loudly' or 'quietly' options]" \
        "--h[use 'loudly' or 'quietly' options]" \
        "1:my message:(quietly loudly)" \
        "2:my message:(boo foo)" \
        "*::arg:->args"

    case $line[1] in
        loudly)
            _core_loudly
        ;;
        quietly)
            _core_quietly
        ;;
    esac
}

function _core_quietly {
    _arguments \
        "--silent[Dont output anything]"
}

function _core_loudly {
    _arguments \
        "--repeat=[Repat the <message> any number of times]"
}
