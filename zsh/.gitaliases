
# ----------------------
# Git Aliases
# ---------------------e
alias g='git'
# Replaced by function instead 
# alias ga='git add'
function ga() {
  git add "*${1}*"
}
alias gaa='git add .'
alias gw='git worktree'
alias gwa='git worktree add'
alias gwl='git worktree list'
alias gap='git add -p'
alias gb='git branch'
alias grm='git branch -D'
alias gc='git commit'
alias gcane='git commit --amend --no-edit'
alias gfix='git commit --fixup `fcs`'
alias gabsorb='GIT_SEQUENCE_EDITOR=: git absorb --and-rebase --force'
alias gamend='gfix && GIT_SEQUENCE_EDITOR=: grsquash -q'
alias gmv='mv-changes `fcs_preview` `fcs_preview` `fzf`'
alias go='git checkout'
alias gcob='git checkout -b'
alias gcom='git checkout master'
alias gcos='git checkout staging'
alias gcod='git checkout develop'
alias gd='git diff'
alias gds='git diff --staged'
alias gda='git diff HEAD'
alias gi='git init'
alias glg='git log'
alias gtree='git log --graph --oneline --decorate --all'
alias glod='git log --graph --pretty="%C(bold Yellow)%h%Creset -%C(auto)%d%Creset %s %Cgreen(%ad) %C(bold blue)<%an>%Creset"'
alias gld='git log --pretty=format:"%C(Yellow)%h%Creset %C(Cyan)%ad%Creset %C(auto)%d%C(reset) %s" --date=short'
alias gm='git merge --no-ff'
alias gma='git merge --abort'
alias gmc='git merge --continue'
alias gp='git stash && git pull --rebase && git stash pop'
alias gpr='git pull --rebase'
alias gr='git rebase'
alias gri='git rebase --interactive'
alias grsquash='git rebase --interactive --autosquash'
alias grc='git rebase --continue'
alias gs='git status'
alias gss='git status --short'
alias gst='git stash'
alias gsta='git stash apply'
alias gstd='git stash drop'
alias gstl='git stash list'
alias gstp='git stash pop'
alias gsts='git stash save'
alias grh='git reset --hard'
alias grs='git reset --soft HEAD~1'
alias gcp='git cherry-pick'
alias gfa='git fetch --all --prune'

# ----------------------
# Git PS Aliases
# ---------------------e
# https://github.com/drewdeponte/git-ps-rs
alias p='gps'
alias mrc='glab mr create'
alias mr='go - && mrc && go -'
alias wip="gcm wip -n"


# alias gcm='git commit --message'
function gcm() {
  local message=$1
  local branch jira prefix description formatted_message

  # Only apply JIRA formatting if in doxyme-core repo
  if ! git remote get-url origin 2>/dev/null | grep -q "doxyme-core"; then
    git commit --message "$message" "${@:2}"
    return 0
  fi

  # Special case: "wip" becomes "chore: NOJIRA - WIP"
  if [[ $message == "wip" ]]; then
    git commit --message "chore: NOJIRA - WIP" "${@:2}"
    return 0
  fi

  # enforce <type>: JIRA - <description>
  # where JIRA = branch-name
  # when branch name has format <JIRA>-XXX
  
  # Get current branch name
  branch=$(git branch --show-current 2>/dev/null)
  
  # Extract JIRA ticket from branch name (format: ABC-123)
  if [[ $branch =~ ^([a-zA-Z]+)-([0-9]+) ]]; then
    # Uppercase the letters part and combine with number
    jira="${${match[1]}:u}-${match[2]}"
  else
    jira="NOJIRA"
  fi
  
  # Check if message follows conventional commits format
  if [[ ! $message =~ '^[a-z]+(\([^)]+\))?:' ]]; then
    echo "Error: Commit message must follow conventional commits format"
    echo "Example: feat: description  OR  feat(scope): description"
    return 1
  fi
  
  # Extract prefix (type with optional scope) and description
  prefix="${message%%: *}"
  description="${message#*: }"
  
  # Reconstruct message with JIRA ticket
  formatted_message="${prefix}: ${jira} - ${description}"
  
  git commit --message "$formatted_message" "${@:2}"
}
