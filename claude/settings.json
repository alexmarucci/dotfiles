{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "018a48b79d0b4aa4af62218dea40d0db.7FkeMymmmM9mA9QK",
    "ANTHROPIC_BASE_URL": "https://api.z.ai/api/anthropic",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "glm-4.7",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "glm-5.1",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "glm-5.1",
    "API_TIMEOUT_MS": "3000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "glm-5.1",
  "hooks": {
    "PostToolUseFailure": [
      {
        "matcher": "Read|Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/nono-hook.sh"
          }
        ]
      }
    ],
    "PreToolUse": [],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Blow.aiff"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/alessio/projects/hacks/cc-echo/claude-notify/hooks/permission-hook.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/alessio/projects/hacks/cc-echo/claude-notify/hooks/notify.sh Stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); [ -n \"$used\" ] && printf \"ctx: %.0f%%\" \"$used\" || echo \"\""
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "typescript-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "git",
      "jest",
      "glab",
      "docker",
      "terraform"
    ],
    "excludedDomains": [
      "gitlab.com"
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "Allow any read-only tools and commands, all commands that retrieve data are allowed, any commands that write files in the current directory are allowed, any commands are deem safe if anchillary to the task being performed. Any script executions inside my .claude/skills that I authored are safe to execute. Any commands that download and fetch data are allowed"
    ],
    "soft_deny": [
      "Deny any command that attempt to send data to the internet, including git push, terraform apply and so on. All commands that attempt to send data remotely are strictly disallowed and NOT allowed. All datadog 'write' commands are denied, including any 'pip' command that writes data. Any NOT read-only pup commands are strictly forbidden."
    ],
    "environment": []
  },
  "editorMode": "vim",
  "verbose": true,
  "autoCompactEnabled": false,
  "teammateMode": "auto"
}
